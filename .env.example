# Всё это вставляется в Netlify → Site configuration → Environment variables

# --- Telegram ---
# юзернейм бота без @ — для кнопок на сайте
BOT_USERNAME=FreeCoursesBot
# (необязательно) свой домен для sitemap/canonical; без него берётся адрес Netlify
SITE_URL=
BOT_TOKEN=токен_от_BotFather
# любая длинная случайная строка (латиница/цифры) — защищает вебхуки
WEBHOOK_SECRET=придумай_длинную_строку_32_символа
# ключ для разовой настройки /api/setup?key=...
SETUP_KEY=ещё_одна_случайная_строка
# твой Telegram ID (@userinfobot), через запятую если несколько
ADMIN_IDS=123456789

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_ключ

# --- Поиск ---
YOUTUBE_API_KEY=ключ_YouTube_Data_API_v3
SEARCH_CACHE_TTL=10800

# --- Pro ---
PRO_DAYS=30
# Крипта: @CryptoBot → Crypto Pay → Create App → API Token
CRYPTOPAY_TOKEN=
PRO_PRICE_USD=2
CRYPTOPAY_ASSETS=USDT,TON,BTC
# 1 = тестовая сеть (@CryptoTestnetBot), для проверки без реальных денег
CRYPTOPAY_TESTNET=0
# Перевод по реквизитам (\n — перенос строки). Пусто = способ скрыт
BANK_PRICE=800 AMD
BANK_DETAILS=Карта: 0000 0000 0000 0000\nПолучатель: Имя Фамилия\nБанк: Название
